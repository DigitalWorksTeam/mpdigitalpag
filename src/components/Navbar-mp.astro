---
import MPDigitalLogo from '/src/img/mpdigitallogo.svg'
---

<!--
  .navbar, .nav-links, .nav-toggle-icon — preservadas para GSAP
  width/height del navbar son controlados exclusivamente por GSAP
-->
<nav
  class="navbar
         ml-5 flex flex-col items-center overflow-hidden
         bg-mp-navy-900/40
         [backdrop-filter:blur(12px)_saturate(180%)_brightness(1.3)]
         [-webkit-backdrop-filter:blur(12px)_saturate(180%)_brightness(1.3)]
         border border-white/10 rounded-2xl
         shadow-[inset_0_0_8px_rgba(255,255,255,0.08),0_8px_24px_-12px_rgba(0,0,0,0.35)]
         transition-[box-shadow,background-color,border-color] duration-200 ease-out
         hover:shadow-[inset_0_0_15px_rgba(255,255,255,0.08),0_20px_48px_-16px_rgba(0,0,0,0.4)]"
  aria-label="Principal"
>

  <!-- Fila superior: logo + toggle — el div completo es el toggleBtn para GSAP -->
  <div
    class="navbar-header
           flex items-center justify-between w-full shrink-0
           gap-[1.2rem] px-[1.2rem] py-[1.2rem] cursor-pointer"
  >
    <a
      class="text-base font-bold tracking-[0.08em] text-mp-slate-50 whitespace-nowrap"
      href="#"
    >
      <MPDigitalLogo class="w-full h-auto" />
    </a>

    <button
      class="nav-toggle
             bg-transparent border-0 cursor-pointer p-0
             w-6 h-6 flex items-center justify-center shrink-0"
      aria-label="Expandir menú"
      aria-expanded="false"
    >
      <img
        class="nav-toggle-icon w-5 h-5 block"
        src="/arrow.svg"
        alt=""
        aria-hidden="true"
      />
    </button>
  </div>

  <!-- Links: opacity y transform gestionados por GSAP -->
  <div
    class="nav-links
           flex flex-col items-start gap-6
           pt-2 pb-6 px-5 w-full"
    aria-hidden="true"
  >
    <a
      href="#proveedores"
      class="text-mp-slate-50/80 text-[0.96rem] whitespace-nowrap
             transition-colors duration-180 ease-in-out
             hover:text-mp-copper-500"
    >
      <span class="text-mp-copper-500" aria-hidden="true">✦</span> Proveedores
    </a>
    <a
      href="#vendemos"
      class="text-mp-slate-50/80 text-[0.96rem] whitespace-nowrap
             transition-colors duration-180 ease-in-out
             hover:text-mp-copper-500"
    >
      <span class="text-mp-copper-500" aria-hidden="true">✦</span> Qué vendemos
    </a>
    <a
      href="#historia"
      class="text-mp-slate-50/80 text-[0.96rem] whitespace-nowrap
             transition-colors duration-180 ease-in-out
             hover:text-mp-copper-500"
    >
      <span class="text-mp-copper-500" aria-hidden="true">✦</span> Historia
    </a>
  </div>

</nav>

<script>
  import { gsap } from 'gsap';

  let isExpanded = false;

  const navbar     = document.querySelector<HTMLElement>('.navbar');
  const navLinks   = document.querySelector<HTMLElement>('.nav-links');
  const toggleBtn  = document.querySelector<HTMLElement>('.navbar-header');
  const toggleIcon = document.querySelector<HTMLImageElement>('.nav-toggle-icon');

  if (!navbar || !navLinks || !toggleBtn || !toggleIcon) {
    console.warn('[Navbar] Elementos no encontrados — revisar el HTML');
  } else {
    gsap.set(navbar,     { width: '256px', height: '90px' });
    gsap.set(navLinks,   { opacity: 0, y: -8 });
    gsap.set(toggleIcon, { rotation: 180 });

    function expand() {
      gsap.killTweensOf([navbar, navLinks, toggleIcon]);
      gsap.timeline({ defaults: { ease: 'power3.inOut' } })
        .to(navbar,     { height: 260, backgroundColor: 'rgba(15,23,32,0.6)', duration: 0.55 })
        .to(toggleIcon, { rotation: 0,   duration: 0.4, ease: 'power2.inOut' }, 0)
        .to(navLinks,   { opacity: 1, y: 0, duration: 0.35 }, '-=0.2');
      navLinks?.removeAttribute('aria-hidden');
      toggleBtn?.setAttribute('aria-expanded', 'true');
    }

    function collapse() {
      gsap.killTweensOf([navbar, navLinks, toggleIcon]);
      gsap.timeline({ defaults: { ease: 'power3.inOut' } })
        .to(navLinks,   { opacity: 0, y: -8, duration: 0.25 })
        .to(toggleIcon, { rotation: 180, duration: 0.4, ease: 'power2.inOut' }, 0)
        .to(navbar,     { height: 90, backgroundColor: 'rgba(15,23,32,0.4)', duration: 0.45 }, '-=0.2');
      navLinks?.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    }

    function toggle() {
      isExpanded = !isExpanded;
      isExpanded ? expand() : collapse();
    }

    toggleBtn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });

    document.addEventListener('click', (e) => {
      if (isExpanded && !navbar.contains(e.target as Node)) {
        isExpanded = false;
        collapse();
      }
    });

    navLinks.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (isExpanded) { isExpanded = false; collapse(); }
      });
    });
  }
</script>