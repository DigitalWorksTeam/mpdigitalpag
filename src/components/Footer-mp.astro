---
import DWLogo       from '/src/img/dwlogo.svg'
import MPDigitalLogo from '/src/img/mpdigitallogo.svg'
import HexaCube     from '/src/img/hexacube.svg'

const footerLinks = [
  { href: '#hero',        label: 'Inicio'       },
  { href: '#proveedores', label: 'Proveedores'  },
  { href: '#vendemos',    label: 'Qué vendemos' },
  { href: '#historia',    label: 'Historia'     },
];

const footerCards = [
  { type: 'brand' },
  { type: 'nav',  title: 'Navegación', links: footerLinks },
  {
    type: 'info',
    title: 'Contacto',
    items: [
      { text: 'dbo@mpdigital.cl', href: '#', external: false },
      { text: 'spl@mpdigital.cl', href: '#', external: false },
      { text: '+56 9 5520 5924',  href: '#', external: false },
    ],
  },
  {
    type: 'info',
    title: 'Información',
    items: [
      { text: 'Operación estructurada para Mercado Público',  href: '#',                           external: false },
      { text: 'Documentación disponible según requerimiento', href: '#',                           external: false },
      { text: 'Descargar ficha empresa',                      href: '/MPDigital_Ficha_Empresa.pdf', external: true  },
    ],
  },
];
---

<footer
  class="border-t border-white/8
         [background:radial-gradient(circle_at_top,rgba(201,137,75,0.12),transparent_30%),linear-gradient(180deg,#0f1720_0%,#111b26_100%)]"
  aria-labelledby="footer-eyebrow"
>
  <div class="max-w-7xl mx-auto p-8">

    <!-- Eyebrow -->
    <p
      id="footer-eyebrow"
      class="flex items-center gap-2 mb-6
             tracking-[0.12em] uppercase text-[0.78rem] font-bold
             text-mp-copper-500"
    >
      <HexaCube class="w-4 h-auto inline" />
      MP Digital
    </p>

    <!-- Cards grid — columnas gestionadas por .footer-grid en global.css -->
    <div class="footer-grid">
      {footerCards.map((card) => (
        <div
          class="flex flex-col gap-3 p-7 rounded-[15px]
                 [background:linear-gradient(180deg,rgba(255,255,255,0.035),rgba(255,255,255,0.01))]
                 border border-white/8
                 shadow-[0_20px_50px_rgba(3,8,12,0.24)]"
        >

          {/* ── BRAND ── */}
          {card.type === 'brand' && (
            <>
              <MPDigitalLogo class="w-full" />
              <p class="text-mp-slate-200 text-base leading-7 m-0">
                Abastecimiento y gestión comercial para Mercado Público.
              </p>
            </>
          )}

          {/* ── NAV ── */}
          {card.type === 'nav' && (
            <>
              <p class="tracking-[0.12em] uppercase text-[0.78rem] font-bold
                        text-mp-copper-500 m-0">
                {card.title}
              </p>
              <nav aria-label="Navegación secundaria">
                <ul class="list-none p-0 m-0 grid gap-[0.6rem]">
                  {card.links?.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="text-mp-slate-200 text-base leading-7
                               no-underline inline-block
                               transition-[color,transform] duration-180 ease-out
                               hover:text-mp-copper-500 hover:translate-x-0.5
                               focus-visible:text-mp-copper-500"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </>
          )}

          {/* ── INFO ── */}
          {card.type === 'info' && (
            <>
              <p class="tracking-[0.12em] uppercase text-[0.78rem] font-bold
                        text-mp-copper-500 m-0">
                {card.title}
              </p>
              <ul class="list-none p-0 m-0 grid gap-[0.6rem]">
                {card.items?.map((item) =>
                  item.href ? (
                    <li>
                      <a
                        href={item.href}
                        class="text-mp-slate-200 text-base leading-7
                               no-underline
                               transition-colors duration-200 ease-in-out
                               hover:text-mp-copper-500"
                        {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      >
                        {item.text}
                      </a>
                    </li>
                  ) : (
                    <li class="text-mp-slate-200 text-base leading-7">
                      {item.text}
                    </li>
                  )
                )}
              </ul>
            </>
          )}

        </div>
      ))}
    </div>

    <!-- Barra inferior -->
    <div
      class="flex justify-between flex-wrap gap-2
             mt-6 pt-6 border-t border-white/8
             max-[560px]:flex-col max-[560px]:items-start"
    >
      <p class="m-0 text-mp-slate-200 text-[0.9rem]">
        © 2026 MP Digital. Todos los derechos reservados.
      </p>

      <div
        class="flex items-center gap-3 text-mp-slate-200 text-[0.9rem]
               max-[560px]:flex-col max-[560px]:items-start max-[560px]:gap-1"
      >
        <span class="flex items-center gap-3">
          Parte de
          <!-- .footer-dw-logo referenciado en global.css para :global(svg) -->
          <a
            href="https://digitalworks.cl/"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-dw-logo inline-flex items-center
                   transition-colors duration-200
                   hover:text-mp-copper-500"
          >
            <DWLogo class:list={[
              "w-30 h-auto block"
            ]} />
          </a>
        </span>
        <small class="opacity-55 text-[0.78rem]">Diseño y desarrollo interno</small>
      </div>
    </div>

  </div>
</footer>